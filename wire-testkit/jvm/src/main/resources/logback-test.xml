<configuration>
  <!-- Wire transcripts carry protocol diagnostics. Suppress per-frame debug logging and redundant target exception traces. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%level %logger - %msg%n%nopex</pattern></encoder>
  </appender>
  <root level="ERROR"><appender-ref ref="STDOUT" /></root>
</configuration>
